# Copy to .env.local and fill in from your Supabase project
# (Project Settings → Data API → Project URL and anon/public key).
#
# Leave these unset and the app runs exactly as before: local-first, on-device,
# with every account and sharing affordance hidden. Nothing breaks.
#
# Before signing in, run supabase/schema.sql once in the SQL editor — it creates
# the tables, the row-level security policies and the private photo bucket.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
